// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["app"]
}

model User {
  id                  String  @id @default(uuid())
  email               String  @unique
  password            String
  name                String
  needsPasswordChange Boolean @default(true)
  mfaSetupComplete    Boolean @default(false)
  otpsecret           String

  roles              Role[]
  sessions           Session[]
  auditLogs          AuditLog[]
  assignments        UserAssignment[]    @relation("UserAssignments")
  grantedAssignments UserAssignment[]    @relation("GrantedUserAssignments")
  managerAccess      UserManagerAccess[]
  deviceKeys         UserDeviceKey[]
  salaryKeyEnvelopes SalaryKeyEnvelope[] @relation("SalaryKeyEnvelopes")

  @@index([email])
  @@schema("app")
}

model Role {
  id   String @id @default(uuid())
  name String @unique

  users       User[]
  permissions Permission[]

  @@index([name])
  @@schema("app")
}

model Permission {
  id   String @id @default(uuid())
  name String @unique

  roles Role[]

  @@index([name])
  @@schema("app")
}

model Employee {
  id          String    @id @default(uuid())
  name        String
  employedAt  DateTime
  memberSince DateTime?
  birthdate   DateTime?
  title       String?
  email       String?
  emailAlt    String?
  phone       String?
  phoneAlt    String?
  gdprConsent DateTime?

  departments Department[]
  managers    Manager[]
  assignments UserAssignment[]
  cases       Case[]
  salaries    Salary[]         @relation("EmployeeSalaries")

  @@index([name])
  @@schema("app")
}

model Manager {
  id      String  @id @default(uuid())
  name    String
  title   String
  chiefId String?

  chief        Manager?  @relation("ChiefManagers", fields: [chiefId], references: [id])
  subordinates Manager[] @relation("ChiefManagers")

  departments         Department[]
  employees           Employee[]
  userManagerAccesses UserManagerAccess[]

  @@index([name])
  @@index([chiefId])
  @@schema("app")
}

model Department {
  id             String  @id @default(uuid())
  name           String
  streetaddress1 String
  streetaddress2 String?
  zipcode        Int
  city           String

  employees   Employee[]
  managers    Manager[]
  assignments UserAssignment[]

  @@index([name])
  @@schema("app")
}

model UserAssignment {
  id               String    @id @default(uuid())
  userId           String
  relationshipType String
  employeeId       String?
  departmentId     String?
  isPrimary        Boolean   @default(false)
  validFrom        DateTime?
  validTo          DateTime?
  grantedByUserId  String?
  createdAt        DateTime  @default(now())

  user       User        @relation("UserAssignments", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy  User?       @relation("GrantedUserAssignments", fields: [grantedByUserId], references: [id], onDelete: SetNull)
  employee   Employee?   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([employeeId])
  @@index([departmentId])
  @@index([userId, relationshipType])
  @@index([validFrom, validTo])
  @@schema("app")
}

model Salary {
  id         String   @id @default(uuid())
  employeeId String
  year       Int
  keyVersion Int      @default(1)
  payload    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee     Employee            @relation("EmployeeSalaries", fields: [employeeId], references: [id], onDelete: Cascade)
  keyEnvelopes SalaryKeyEnvelope[]

  @@unique([employeeId, year])
  @@index([employeeId])
  @@schema("app")
}

model SalaryKeyEnvelope {
  id              String   @id @default(cuid())
  salaryId        String
  recipientUserId String
  recipientKeyId  String
  wrapAlg         String
  edk             String
  createdAt       DateTime @default(now())

  salary Salary @relation(fields: [salaryId], references: [id], onDelete: Cascade)
  user   User   @relation("SalaryKeyEnvelopes", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@unique([salaryId, recipientKeyId])
  @@index([salaryId])
  @@index([recipientUserId])
  @@schema("app")
}

model Case {
  id         String   @id @default(uuid())
  payload    Json
  keyVersion Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employeeId String

  employee     Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  keyEnvelopes CaseKeyEnvelope[]

  @@index([employeeId])
  @@schema("app")
}

model CaseKeyEnvelope {
  id              String   @id @default(uuid())
  caseId          String
  recipientUserId String
  recipientKeyId  String
  wrapAlg         String
  edk             String
  createdAt       DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, recipientKeyId])
  @@index([caseId])
  @@index([recipientUserId])
  @@schema("app")
}

model AuditLog {
  id                 String   @id @default(uuid())
  userId             String?
  action             String
  target_resource_id String
  ip_address         String
  sessionId          String?
  success            Boolean
  createdAt          DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: NoAction)
  session Session? @relation(fields: [sessionId], references: [sessionId], onDelete: NoAction)

  @@index([userId, target_resource_id])
  @@schema("app")
}

model Session {
  id         String   @id @default(uuid())
  sessionId  String   @unique
  userId     String
  ip_address String
  expiresAt  DateTime @default(dbgenerated("NOW() + INTERVAL '86400 seconds'"))
  createdAt  DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditLogs AuditLog[]

  @@index([sessionId])
  @@schema("app")
}

model UserDeviceKey {
  id         String    @id @default(uuid())
  userId     String
  keyId      String    @unique
  publicKey  Json
  privateKey Json?
  algorithm  String
  kind       String    @default("device")
  status     String    @default("active")
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyId])
  @@index([userId, kind, status])
  @@schema("app")
}

model UserManagerAccess {
  id        String   @id @default(uuid())
  userId    String
  managerId String
  grantedAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  manager Manager @relation(fields: [managerId], references: [id], onDelete: Cascade)

  @@unique([userId, managerId])
  @@index([userId])
  @@schema("app")
}
