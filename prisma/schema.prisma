// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["app"]
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String
  name     String

  roles         Role[]
  sessions      Session[]
  auditLogs     AuditLog[]
  managerAccess UserManagerAccess[]

  @@index([email])
  @@schema("app")
}

model Role {
  id   String @id @default(uuid())
  name String @unique

  users       User[]
  permissions Permission[]

  @@index([name])
  @@schema("app")
}

model Permission {
  id   String @id @default(uuid())
  name String @unique

  roles Role[]

  @@index([name])
  @@schema("app")
}

model Employee {
  id          String    @id @default(uuid())
  name        String
  employedAt  DateTime
  memberSince DateTime?
  birthdate   DateTime?
  title       String?
  email       String?
  emailAlt    String?
  phone       String?
  phoneAlt    String?
  gdprConsent DateTime?

  departments Department[]
  managers    Manager[]
  salaries    Salary?
  cases       Case[]

  @@index([name])
  @@schema("app")
}

model Manager {
  id      String  @id @default(uuid())
  name    String
  chiefId String?

  chief        Manager?  @relation("ChiefManagers", fields: [chiefId], references: [id])
  subordinates Manager[] @relation("ChiefManagers")

  departments         Department[]
  employees           Employee[]
  userManagerAccesses UserManagerAccess[]

  @@index([name])
  @@index([chiefId])
  @@schema("app")
}

model Department {
  id             String  @id @default(uuid())
  name           String
  streetaddress1 String
  streetaddress2 String?
  zipcode        Int
  city           String

  employees Employee[]
  managers  Manager[]

  @@index([name])
  @@schema("app")
}

model Salary {
  id         String   @id @default(uuid())
  payload    Bytes
  keyVersion Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employeeId String   @unique

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@schema("app")
}

model Case {
  id         String   @id @default(uuid())
  payload    Bytes
  keyVersion Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employeeId String

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@schema("app")
}

model AuditLog {
  id                 String   @id @default(uuid())
  userId             String
  action             String
  target_resource_id String
  ip_address         String
  sessionId          String
  success            Boolean
  createdAt          DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: NoAction)
  session Session @relation(fields: [sessionId], references: [sessionId], onDelete: NoAction)

  @@index([userId, target_resource_id])
  @@schema("app")
}

model Session {
  id         String   @id @default(uuid())
  sessionId  String   @unique
  userId     String
  ip_address String
  createdAt  DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditLogs AuditLog[]

  @@index([sessionId])
  @@schema("app")
}

model UserManagerAccess {
  id        String   @id @default(uuid())
  userId    String
  managerId String
  grantedAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  manager Manager @relation(fields: [managerId], references: [id], onDelete: Cascade)

  @@unique([userId, managerId])
  @@index([userId])
  @@schema("app")
}
